# TruthGuard AI - Environment Variables (Backend Server Only)
# Never expose these keys in client-side code, browser bundles, or git commits.

# GroqCloud API Key: AI-powered analysis and verification
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NewsAPI Key: Live news, articles, and supporting evidence
# Get your free developer API key at https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# Backend API server port (default: 3001)
API_PORT=3001

# Optional: Groq model override (default: llama-3.3-70b-versatile)
# Supported models include: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
