# Server-only secrets — never put these in frontend code.
# Leave a key empty to use clearly labelled demo results for that part.

# https://console.groq.com/keys
GROQ_API_KEY=
# https://newsapi.org/register (free developer key, works from localhost)
NEWS_API_KEY=

# Defaults to 3001 when empty
API_PORT=
# Optional: override the Groq model if it is retired
# GROQ_MODEL=openai/gpt-oss-120b
